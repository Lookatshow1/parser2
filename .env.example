DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/ads
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
APP_NAME=ads-aggregator
API_HOST=0.0.0.0
API_PORT=8000
DEV_MODE=false

# =============================================================================
# ADVERTISING PLATFORMS (REQUIRED FOR REAL ADS)
# =============================================================================

# Yandex Direct OAuth
# Get credentials at: https://oauth.yandex.ru/client/new
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Yandex Direct Reports API
# Get token in Yandex.Direct cabinet -> Settings -> API access
YANDEX_REPORTS_URL=https://api.direct.yandex.com/json/v5/reports
YANDEX_REPORTS_TOKEN=
YANDEX_REPORTS_SKIP_HEADER=true

# VK Ads OAuth
# Get credentials at: https://ads.vk.com/ -> My Apps
VK_ADS_CLIENT_ID=
VK_ADS_CLIENT_SECRET=
VK_ADS_REDIRECT_URI=http://localhost:3000/callback/vk

# Ozon Performance API
# Get credentials at: https://performance.ozon.ru/
# Note: Ozon real API implementation is in progress
OZON_CLIENT_ID=
OZON_CLIENT_SECRET=

# =============================================================================
# MOCK MODES (set to 1 to use mock data instead of real API)
# =============================================================================
YANDEX_DIRECT_MOCK=0
VK_ADS_MOCK=0
OZON_PERF_MOCK=0
CORS_ORIGINS=*
ENV=dev
SECRET_KEY=dev_secret
JWT_ALG=HS256
ACCESS_TTL_MIN=60
REFRESH_TTL_DAYS=7
ACCESS_TOKEN_EXPIRE_MINUTES=60
CREDENTIALS_ENC_KEYS=dev:MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
CREDENTIALS_ENC_ACTIVE_KID=dev
ENABLE_DEV_ENDPOINTS=true
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo12345
DEMO_ORG_NAME=Демо-организация
DEMO_CONNECTIONS=Яндекс.Директ: Демо 1,Яндекс.Директ: Демо 2
DEMO_FORCE_PASSWORD=false

# =============================================================================
# AI PROVIDERS
# =============================================================================

# OpenRouter - Universal AI Access (100+ models with proxy support)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_PROXY_URL=
OPENROUTER_DEFAULT_MODEL=gpt-4o-mini

# GigaChat (Sber) - Works in Russia without VPN
# Get your key at https://developers.sber.ru/portal/products/gigachat-api
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# OpenAI Direct (optional - OpenRouter recommended instead)
OPENAI_API_KEY=

# Anthropic Direct (optional - OpenRouter recommended instead)
ANTHROPIC_API_KEY=

# ElevenLabs - Voice AI for ad voiceovers
# Get your key at https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE=ru_female_pro

# HeyGen - AI Video Generation
# Get your key at https://heygen.com/
HEYGEN_API_KEY=
HEYGEN_DEFAULT_AVATAR=anna_professional

# =============================================================================
# AI ORCHESTRATOR SETTINGS
# =============================================================================

# Optimization target: quality, speed, or cost
AI_OPTIMIZE_FOR=quality

# Enable parallel AI requests for faster generation
AI_ENABLE_PARALLEL=true

# Enable automatic fallback to other providers on failure
AI_ENABLE_FALLBACK=true

# =============================================================================
# MAGIC LAUNCH SETTINGS
# =============================================================================

# Auto-generate images with ad creatives
MAGIC_AUTO_GENERATE_IMAGES=true

# Auto-generate voiceovers (requires ElevenLabs)
MAGIC_AUTO_GENERATE_VOICE=false

# Auto-generate video ads (requires HeyGen)
MAGIC_AUTO_GENERATE_VIDEO=false

# Default platforms for Magic Launch
MAGIC_DEFAULT_PLATFORMS=yandex,vk

# =============================================================================
# TELEGRAM NOTIFICATIONS
# =============================================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# =============================================================================
# PRODUCTION SETTINGS (required for docker-compose.prod.yml)
# =============================================================================

# Database credentials (required in production)
POSTGRES_USER=reklai
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=reklai

# Redis password (required in production)
REDIS_PASSWORD=your-redis-password-here

# Admin panel credentials (required in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password-min-16-chars

# Domain settings
WEB_BASE_URL=https://reklai.ru
NEXT_PUBLIC_API_URL=https://api.reklai.ru
CORS_ORIGINS=https://reklai.ru,https://www.reklai.ru

# Let's Encrypt email for SSL certificates
ACME_EMAIL=admin@reklai.ru

# Traefik dashboard auth (generate with: htpasswd -nb admin password)
TRAEFIK_AUTH=admin:$$apr1$$your-hash-here
